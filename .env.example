# FieldLens local development settings. Copy nothing by hand:
#   uv run python scripts/init_env.py
# creates the untracked, owner-only .env (mode 0600) or appends only the keys missing from
# it, generating the database password. Existing lines are never rewritten or printed.
#
# Naming scheme: POSTGRES_* (also read by Compose for the container), FIELDLENS_* (application,
# tests and scripts). The one exception is MODEL_API_KEY (owner decision 2026-10-30 13:41 EDT):
# the application settings adopt exactly that name as the provider secret; its value is never
# kept here. Every other key is ignored. Tests force it blank; derived lane .env files never
# carry it, so live/provider runs use the root .env.
#
# Compose and python-dotenv both expand ${VAR} from earlier lines. The password is URL-safe.

# PostgreSQL role created on the first start of the fresh fieldlens_pgdata volume.
POSTGRES_USER=fieldlens
# Generated by the bootstrap script. Postgres fixes credentials at first initialization;
# changing this later does not change an existing volume.
POSTGRES_PASSWORD=generated-by-init-env
# Application database. Tests create fieldlens_app_test_<8 hex> siblings and drop them.
POSTGRES_DB=fieldlens_app
# Loopback port published by Compose and used by the application URL.
FIELDLENS_DB_PORT=55432
# Application connection URL composed from the values above (loopback, psycopg driver).
FIELDLENS_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${FIELDLENS_DB_PORT}/${POSTGRES_DB}
# Uploaded originals and scratch space (relative paths are anchored to the repository root).
FIELDLENS_STORAGE_ROOT=.local/fieldlens/storage

# Optional override (not set by default): FIELDLENS_TEST_DATABASE_URL must be loopback,
# postgresql+psycopg and named fieldlens_app_test_<8 lowercase hex>. Otherwise tests derive
# a unique sibling of the application database on the same server.

# Meta provider (server-side only; no live call happens in default tests or `./dev up`).
# Not set by default and never stored in this file: set MODEL_API_KEY in the
# server's process environment or the untracked root .env (there is no FIELDLENS_ alias). When it is absent the provider
# fails closed with a typed `provider_unavailable` error before any request. Optional lowering
# overrides: FIELDLENS_META_BASE_URL (https, default https://api.meta.ai/v1), FIELDLENS_META_MODEL,
# FIELDLENS_BUDGET_LEDGER_CAP_USD (<=150), FIELDLENS_PROVIDER_MAX_TOOL_CALLS (default 6).

# Staged document processing (TASK-054/055/072). Settings read ONLY the FIELDLENS_-prefixed names;
# an unprefixed PROCESSING_* key is ignored (startup logs a warning naming the prefixed variable).
# Left empty = not set: the stub provider runs and no model is called. For the live model set
# FIELDLENS_PROCESSING_PROVIDER=meta together with MODEL_API_KEY (never stored here) and both owner
# Meta rates (USD per million tokens); otherwise processing requests are refused with
# `provider_misconfigured`. No balance step is needed: the `processing-live` ledger period is made
# usable at startup and your confirmation of each estimate authorises that run. Remaining ceilings:
# the optional per-run cap below (<= 5; blank = none), FIELDLENS_PROCESSING_TOTAL_CAP_USD (default 5,
# <= 5, shared by all processing) and FIELDLENS_PROVIDER_MAX_RESERVED_USD (per model call, <= 0.50).
FIELDLENS_PROCESSING_PROVIDER=
FIELDLENS_PROCESSING_RUN_CAP_USD=
FIELDLENS_PROCESSING_META_INPUT_USD_PER_MTOK=
FIELDLENS_PROCESSING_META_OUTPUT_USD_PER_MTOK=
# Pages per document sent to the model (default 5, at most 20).
FIELDLENS_PROCESSING_MODEL_PAGES=

# Playwright browser container used by `npm --prefix frontend run test:e2e`.
FIELDLENS_PW_CONNECT_WS_ENDPOINT=ws://127.0.0.1:9323/
FIELDLENS_PW_EXPOSE_NETWORK=<loopback>

# Tooling credentials (scripts/notify.py, Taiga sync). Left empty here; fill in the untracked
# .env only. Never put a comment after a secret value on the same line (a space followed by
# # starts a comment). Never commit values.
# Telegram bot token and the chat id that receives messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 1 to let `notify.py inbox --once` read commands from TELEGRAM_CHAT_ID (default off).
TELEGRAM_INBOX=
# Taiga credentials; project slug defaults to slimco86-test, URL to https://api.taiga.io.
TAIGA_USERNAME=
TAIGA_PASSWORD=
TAIGA_PROJECT_SLUG=
TAIGA_URL=
# Set to 1 to allow syncing to a non-private Taiga project.
TAIGA_ALLOW_PUBLIC=
# Optional: read-only root of the local Volve data for opt-in local_data tests (unset skips them).
# Example (WSL): /mnt/c/Users/<you>/Downloads/Hackathon_Data
# FIELDLENS_LOCAL_DATA_ROOT=/mnt/c/Users/<you>/Downloads/Hackathon_Data
